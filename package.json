{
  "name": "seqlyn-labs-shop",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build-shop.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-turso.mjs",
    "db:migrate:supabase": "node --env-file-if-exists=.env.local scripts/migrate-supabase.mjs",
    "check:deploy": "node --env-file-if-exists=.env.local scripts/check-deploy.mjs",
    "preview:vercel": "node --env-file-if-exists=.env.local scripts/preview-vercel.mjs",
    "verify:vercel": "node scripts/verify-vercel.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "cheerio": "1.2.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@libsql/client": "^0.18.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "postgres": "^3.4.9"
  }
}
