# Vercel server environment variables. Never put credentials in browser scripts.
COMMERCE_MODE=test
# Supabase deployment (recommended for the connected Seqlyn Labs project)
AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=
SUPABASE_GOOGLE_ENABLED=false
# Google is configured in Supabase Authentication > Providers.
# Owner-confirmed administrator email; Google must verify this exact account.
SHOP_ADMIN_EMAIL=info@seqlynlabs.com
# Alternative legacy deployment: AUTH_PROVIDER=authjs with Turso + direct Google
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional build-time HTTPS origin. Leave blank until the public domain is chosen.
PUBLIC_SITE_URL=
# Email: sending-only Resend key restricted to seqlynlabs.com. Server secrets only.
RESEND_API_KEY=
EMAIL_FROM=Seqlyn Labs <info@seqlynlabs.com>
EMAIL_REPLY_TO=info@seqlynlabs.com
# Random secret used by Vercel's daily email retry job.
CRON_SECRET=
# Required before newsletter campaigns can be sent.
NEWSLETTER_POSTAL_ADDRESS=
